---
import Base from '../layouts/Base.astro';
import Cap from '../components/Cap.astro';
import Ikon from '../components/Ikon.astro';
import KartuProduk from '../components/KartuProduk.astro';
import { semuaProduk, waLink, toko, u, KELOMPOK, kelompok } from '../lib/data.js';
const produk = await semuaProduk();
const jumlah = Object.fromEntries(KELOMPOK.map((k) => [k, produk.filter((p) => kelompok(p) === k).length]));
const tahun = new Date().getFullYear() - toko.berdiri;

const sejarah = [
  {
    tahun: '1986',
    judul: 'Bengkel dibuka di Ceper',
    teks: 'Bapak Samidi mendirikan Estu Karya di tepi jalan Solo-Yogya, Ceper, Klaten, dengan peralatan bengkel sederhana dan pengalaman kerja di bidang alat mesin pertanian.',
    foto: '/foto/arsip/pande-besi.jpg',
    alt: 'Pande besi di bengkel Estu Karya',
  },
  {
    tahun: '2013',
    judul: 'Katalog online pertama',
    teks: 'Website estukarya.com terbit dengan lebih dari 40 produk buatan bengkel sendiri: power thresher, hammermill, mesin pakan ikan, cangkul, dan sabit.',
    foto: '/foto/arsip/proses-pembuatan-alat-mesin-pertanian.jpg',
    alt: 'Perakitan alat mesin pertanian di bengkel Estu Karya',
  },
  {
    tahun: '2015',
    judul: 'Gudang barang teknik dibuka untuk umum',
    teks: 'Mesin dan peralatan dari gudang mulai dijual satuan dan dilelang, dari mesin bubut sampai granulator dan dryer pupuk.',
    foto: '/foto/arsip/granulator.jpg',
    alt: 'Granulator pupuk di gudang Estu Karya',
  },
  {
    tahun: 'Kini',
    judul: 'Supplier di Meger, Ceper',
    teks: 'Dengan logo baru, Estu Karya memasok alat mesin, perkakas, dan teknologi tepat guna, eceran dan grosir, ke seluruh Indonesia.',
    foto: '/logo/logo-lengkap.png',
    alt: 'Logo Estu Karya',
    logo: true,
  },
];
---
<Base judul={toko.nama}>
  <section class="hero">
    <div class="wadah">
      <div>
        <h1>Alat mesin dan perkakas sejak 1986</h1>
        <p>Dari bengkel pande besi di Ceper, Klaten, sampai supplier untuk petani, toko tani, bengkel, dan usaha rumahan di seluruh Indonesia. Eceran dan grosir, pesan langsung lewat WhatsApp.</p>
        <div class="hero__aksi">
          <a class="tombol tombol--utama" href="#katalog">Lihat katalog</a>
          <a class="tombol tombol--garis" href={waLink('Halo Estu Karya, saya mau bertanya.')} target="_blank" rel="noopener"><Ikon nama="wa" />Chat WhatsApp</a>
        </div>
        <div class="hero__fakta">
          <div><b>{tahun} tahun</b><span>berdiri di Ceper, Klaten</span></div>
          <div><b>{produk.length} barang</b><span>di katalog</span></div>
          <div><b>Eceran dan grosir</b><span>kirim ke seluruh Indonesia</span></div>
        </div>
      </div>
      <figure class="hero__foto" style="margin:0">
        <img src={u('/foto/situs/hero.jpg')} alt="Sawah di Jawa" width="1200" height="900" fetchpriority="high" />
        <Cap />
      </figure>
    </div>
  </section>

  <section class="bagian">
    <div class="wadah">
      <div class="kepala-bagian">
        <div>
          <h2 class="judul-besar">Empat puluh tahun di alat tani</h2>
          <p class="redup">Perjalanan Estu Karya dari bengkel produksi sampai supplier, dari arsip keluarga dan website lama.</p>
        </div>
        <a href={u('/tentang/')}>Baca sejarah lengkap</a>
      </div>
      <div class="linimasa">
        {sejarah.map((s) => (
          <article class="pos">
            <div class="pos__foto">
              <img src={u(s.foto)} alt={s.alt} width="600" height="450" loading="lazy" style={s.logo ? 'object-fit:contain;padding:1.25rem;background:#fff' : undefined} />
            </div>
            <div class="pos__isi">
              <span class="pos__tahun">{s.tahun}</span>
              <h3>{s.judul}</h3>
              <p>{s.teks}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bagian pita-navy" id="katalog">
    <div class="wadah">
      <div class="kepala-bagian">
        <div>
          <h2 class="judul-besar">Katalog</h2>
          <p class="redup">Pilih barang, masukkan keranjang, lalu kirim pesanan lewat WhatsApp.</p>
        </div>
      </div>
      <div class="tab-katalog" role="group" aria-label="Pilih kelompok barang">
        <button type="button" data-tab="semua" aria-pressed="true">Semua ({produk.length})</button>
        {KELOMPOK.map((k) => <button type="button" data-tab={k} aria-pressed="false">{k} ({jumlah[k]})</button>)}
      </div>
      <div class="grid-produk" data-katalog>
        {produk.map((p) => <KartuProduk p={p} />)}
      </div>
    </div>
  </section>

  <section class="bagian">
    <div class="wadah alasan">
      <div><Ikon nama="sejarah" /><h3>Berdiri sejak 1986</h3><p>Pengalaman bengkel produksi dipakai untuk memilih alat yang awet.</p></div>
      <div><Ikon nama="grosir" /><h3>Eceran dan grosir</h3><p>Beli satu untuk sawah sendiri, atau satu kodi untuk stok toko tani.</p></div>
      <div><Ikon nama="truk" /><h3>Kirim ke seluruh Indonesia</h3><p>Ekspedisi untuk perkakas, kargo atau truk untuk mesin berat.</p></div>
      <div><Ikon nama="wa" /><h3>Pesan lewat WhatsApp</h3><p>Admin membalas dengan total, ongkir, dan cara bayar.</p></div>
    </div>
  </section>
</Base>
