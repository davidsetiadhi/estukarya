---
// Small inline icon set (stroke icons, 24x24 grid).
interface Props { nama: 'wa' | 'keranjang' | 'menu' | 'truk' | 'grosir' | 'sejarah' | 'cek' | 'lokasi' | 'telepon'; }
const { nama } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nama === 'wa' && (<><path d="M3 21l1.65-4.5A8.5 8.5 0 1 1 8 19.6L3 21z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5z" /></>)}
  {nama === 'keranjang' && (<><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6" /><circle cx="9" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" /></>)}
  {nama === 'menu' && (<><path d="M4 7h16M4 12h16M4 17h16" /></>)}
  {nama === 'truk' && (<><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7" /><circle cx="6" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></>)}
  {nama === 'grosir' && (<><path d="M3 9l9-5 9 5-9 5-9-5z" /><path d="M3 14l9 5 9-5" /></>)}
  {nama === 'sejarah' && (<><path d="M12 7v5l3 2" /><path d="M3.5 12a8.5 8.5 0 1 0 2.5-6L3.5 8.5" /><path d="M3.5 4v4.5H8" /></>)}
  {nama === 'cek' && (<><path d="M4 12.5l5 5L20 6.5" /></>)}
  {nama === 'lokasi' && (<><path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {nama === 'telepon' && (<><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" /></>)}
</svg>
