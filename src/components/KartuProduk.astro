---
import { rupiah, urlProduk, kelompok } from '../lib/data.js';
interface Props { p: any }
const { p } = Astro.props;
const terjual = p.stok === 'terjual';
const bekas = p.segmen === 'bekas';
const tag = terjual ? 'Terjual' : bekas ? 'Bekas' : 'Baru';
const poin = p.spesifikasi.slice(0, 1).map(([k, v]) => (k ? `${k}: ${v}` : v));
const stokAda = ['tersedia', 'tanya'].includes(p.stok);
---
<article
  class:list={['kartu', { 'kartu--terjual': terjual }]}
  data-kategori={p.kategori}
  data-kelompok={kelompok(p)}
  data-cari={`${p.nama} ${p.kategori} ${p.ringkas}`.toLowerCase()}
>
  <span class:list={['kartu__tag', { 'kartu__tag--bekas': bekas && !terjual, 'kartu__tag--terjual': terjual }]}>{tag}</span>
  <div class="kartu__foto">
    {p.foto[0] && <img src={p.foto[0]} alt={p.nama} width="600" height="600" loading="lazy" decoding="async" />}
  </div>
  <div class="kartu__isi">
    <span class="kartu__kat">{p.kategori}</span>
    <h3><a href={urlProduk(p)}>{p.nama}</a></h3>
    <ul class="kartu__poin">{(poin.length ? poin : [p.ringkas]).map((t) => <li>{t}</li>)}</ul>
    <div class="kartu__harga">
      {p.harga ? <span>{rupiah(p.harga)}</span> : <span class="kartu__harga--tanya">{terjual ? 'Terjual' : 'Tanya harga'}</span>}
      <span class:list={['kartu__stok', { 'kartu__stok--tidak': !stokAda }]}>{p.stok === 'tersedia' ? 'Tersedia' : p.stok === 'dipesan' ? 'Dipesan' : p.stok === 'habis' ? 'Habis' : terjual ? '' : 'Cek stok'}</span>
    </div>
    <a class="kartu__tombol" href={urlProduk(p)} tabindex="-1" aria-hidden="true">Lihat detail</a>
  </div>
</article>
